<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <Preference android:title="@string/profile" android:key="@string/pref_osm_profile" android:order="1" app:singleLineTitle="false" />
    <androidx.preference.PreferenceCategory android:title="@string/prefs_group_general" android:key="@string/pref_settings_general" android:order="2">
        <ListPreference android:entries="@array/measument_units" android:title="@string/measurement_units" android:key="@string/pref_munits" android:summary="@string/measurement_units_summary" android:order="1" android:entryValues="@array/measument_units_values" app:singleLineTitle="false" />
        <SwitchPreferenceCompat android:title="@string/pref_zoom_title" android:key="@string/pref_show_zoom_buttons" android:summary="@string/pref_zoom_summary" android:order="2" app:singleLineTitle="false" />
        <SwitchPreferenceCompat android:title="@string/pref_map_3d_buildings_title" android:key="@string/pref_3d_buildings" android:order="3" app:singleLineTitle="false" />
        <SwitchPreferenceCompat android:title="@string/autodownload" android:key="@string/pref_autodownload" android:order="4" app:singleLineTitle="false" />
        <SwitchPreferenceCompat android:title="@string/big_font" android:key="@string/pref_large_fonts_size" android:order="6" android:defaultValue="false" app:singleLineTitle="false" />
        <SwitchPreferenceCompat android:title="@string/transliteration_title" android:key="@string/pref_transliteration" android:order="7" android:defaultValue="false" app:singleLineTitle="false" />
        <Preference android:title="@string/maps_storage" android:key="@string/pref_storage" android:summary="@string/maps_storage_summary" android:order="8" app:singleLineTitle="false" />
        <SwitchPreferenceCompat android:title="@string/enable_logging" android:key="@string/pref_enable_logging" android:summary="@string/enable_logging_warning_message" android:order="12" android:defaultValue="false" app:singleLineTitle="false" />
        <SwitchPreferenceCompat android:title="@string/setting_emulate_bad_storage" android:key="@string/pref_emulate_bad_external_storage" android:order="13" android:defaultValue="false" app:isPreferenceVisible="false" app:singleLineTitle="false" />
        <ListPreference android:entries="@array/mobile_data_options" android:title="@string/mobile_data" android:key="@string/pref_use_mobile_data" android:summary="@string/mobile_data_description" android:order="14" android:entryValues="@array/mobile_data_options_values" app:singleLineTitle="false" />
        <ListPreference android:entries="@array/power_management_scheme" android:title="@string/power_managment_title" android:key="@string/pref_power_management" android:summary="@string/power_managment_description" android:order="15" android:entryValues="@array/power_management_scheme_values" app:singleLineTitle="false" />
        <ListPreference android:entries="@array/bookmarks_text_placement_options" android:title="@string/bookmarks_text_placement_title" android:key="@string/pref_bookmarks_text_placement" android:summary="@string/bookmarks_text_placement_description" android:order="16" android:entryValues="@array/bookmarks_text_placement_values" app:singleLineTitle="false" />
        <SwitchPreferenceCompat android:title="@string/enable_keep_screen_on" android:key="@string/pref_keep_screen_on" android:summary="@string/enable_keep_screen_on_description" android:order="17" android:defaultValue="false" app:singleLineTitle="false" />
        <SwitchPreferenceCompat android:title="@string/enable_show_on_lock_screen" android:key="@string/pref_show_on_lock_screen" android:summary="@string/enable_show_on_lock_screen_description" android:order="18" android:defaultValue="true" app:singleLineTitle="false" />
        <Preference android:persistent="false" android:title="@string/change_map_locale" android:key="@string/pref_map_locale" android:order="19" app:singleLineTitle="false" />
    </androidx.preference.PreferenceCategory>
    <androidx.preference.PreferenceCategory android:title="@string/prefs_group_route" android:key="@string/pref_navigation" android:order="3">
        <ListPreference android:entries="@array/map_style" android:title="@string/pref_map_style_title" android:key="@string/pref_map_style" android:order="1" android:entryValues="@array/map_style_values" app:singleLineTitle="false" />
        <SwitchPreferenceCompat android:title="@string/pref_map_3d_title" android:key="@string/pref_3d" android:order="2" app:singleLineTitle="false" />
        <SwitchPreferenceCompat android:title="@string/pref_map_auto_zoom" android:key="@string/pref_auto_zoom" android:order="3" app:singleLineTitle="false" />
        <Preference android:persistent="false" android:title="@string/pref_tts_enable_title" android:key="@string/pref_tts_screen" android:order="4" app:singleLineTitle="false" />
        <PreferenceScreen android:title="@string/driving_options_title" android:key="@string/prefs_routing" android:order="5">
            <intent android:targetPackage="@string/app_id" android:targetClass="app.organicmaps.settings.DrivingOptionsActivity">
                <extra android:name="from" android:value="settings" />
            </intent>
        </PreferenceScreen>
    </androidx.preference.PreferenceCategory>
    <androidx.preference.PreferenceCategory android:title="@string/privacy" android:key="@string/pref_privacy" android:order="6">
        <SwitchPreferenceCompat android:title="@string/google_play_services" android:key="@string/pref_play_services" android:summary="@string/pref_use_google_play" android:order="1" android:defaultValue="true" app:singleLineTitle="false" />
        <SwitchPreferenceCompat android:title="@string/search_history_title" android:key="@string/pref_search_history" android:order="2" android:defaultValue="true" app:singleLineTitle="false" />
    </androidx.preference.PreferenceCategory>
    <androidx.preference.PreferenceCategory android:title="@string/prefs_group_information" android:key="@string/pref_information" android:order="7">
        <Preference android:title="@string/help" android:key="@string/pref_help" android:order="1" app:singleLineTitle="false" />
    </androidx.preference.PreferenceCategory>
</androidx.preference.PreferenceScreen>